# ==============================================================================
# Asmatullah & Brothers Construction Co. - SMTP Email Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. On your DirectAdmin server, copy or rename this file to '.env' inside the 'api/' folder (or the root of public_html).
# 2. Fill in your actual SMTP server credentials from DirectAdmin -> E-Mail Accounts.

# SMTP Server Host (e.g., mail.yourdomain.com or smtp.gmail.com)
SMTP_HOST=mail.yourdomain.com

# SMTP Port: 587 (TLS / STARTTLS - Recommended) or 465 (SSL) or 25
SMTP_PORT=587

# Encryption Type: 'tls', 'ssl', or 'none'
SMTP_SECURE=tls

# Enable SMTP Authentication: 'true' or 'false'
SMTP_AUTH=true

# SMTP Login Credentials
SMTP_USERNAME=info@yourdomain.com
SMTP_PASSWORD=your_secure_email_password_here

# Sender Details (Must match or be authorized by SMTP_USERNAME)
SMTP_FROM_EMAIL=info@yourdomain.com
SMTP_FROM_NAME=Asmatullah & Brothers Construction Co.

# Primary Recipient where inquiries & tender BOQs should be delivered
SMTP_TO_EMAIL=info@asmatullahbrothers.com

# Optional CC / BCC Email (leave blank if not needed)
SMTP_CC_EMAIL=
SMTP_BCC_EMAIL=

# Auto-Reply to customer: 'true' or 'false'
SEND_AUTOREPLY=true
